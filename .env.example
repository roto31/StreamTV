# StreamTV secrets template.
# Copy to ~/.streamtv/secrets.env (chmod 600) or export in the service
# environment. Never commit real values; config.yaml must keep these null.
# Custom location: set STREAMTV_SECRETS_FILE=/path/to/secrets.env

# YouTube Data API v3
STREAMTV_YOUTUBE_API_KEY=
STREAMTV_YOUTUBE_OAUTH_CLIENT_ID=
STREAMTV_YOUTUBE_OAUTH_CLIENT_SECRET=
STREAMTV_YOUTUBE_OAUTH_REFRESH_TOKEN=

# Archive.org (S3-style keys from https://archive.org/account/s3.php)
STREAMTV_ARCHIVE_ORG_USERNAME=
STREAMTV_ARCHIVE_ORG_PASSWORD=
STREAMTV_ARCHIVE_ORG_S3_ACCESS_KEY=
STREAMTV_ARCHIVE_ORG_S3_SECRET_KEY=

# Plex Media Server
STREAMTV_PLEX_TOKEN=

# Metadata providers
STREAMTV_METADATA_TVDB_API_KEY=
STREAMTV_METADATA_TVDB_PIN=
STREAMTV_METADATA_TVDB_READ_TOKEN=
STREAMTV_METADATA_TMDB_API_KEY=

# PBS
STREAMTV_PBS_USERNAME=
STREAMTV_PBS_PASSWORD=

# StreamTV API auth
STREAMTV_SECURITY_ACCESS_TOKEN=
