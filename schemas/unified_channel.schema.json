{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StreamTV Unified Channel Schema v1",
  "description": "Single-file authoring format that compiles to inventory (data/channels_*.yaml) and playout (schedules/{number}.yml). StreamTV owns this contract.",
  "type": "object",
  "required": ["channel", "streams", "schedule"],
  "properties": {
    "config_revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Bump on every edit; importer uses it with data/manifest.yaml to detect drift"
    },
    "channel": {
      "type": "object",
      "required": ["number", "name"],
      "properties": {
        "number": { "type": "string" },
        "name": { "type": "string" },
        "group": { "type": "string" },
        "description": { "type": "string" },
        "enabled": { "type": "boolean", "default": true },
        "playout_mode": {
          "type": "string",
          "enum": ["continuous", "on_demand"],
          "default": "continuous"
        },
        "epg_sync_class": {
          "type": "string",
          "enum": ["A", "B", "C"],
          "description": "EPG sync taxonomy: A short-form continuous, B archive marathon, C cycle/idle"
        }
      }
    },
    "streams": {
      "type": "array",
      "minItems": 1,
      "description": "Inventory layer — same shape as channels YAML streams",
      "items": {
        "type": "object",
        "required": ["id", "collection"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Globally unique stream id (cache source_id); uniqueness across all files is enforced at import"
          },
          "collection": { "type": "string" },
          "type": { "type": "string" },
          "source": { "type": "string" },
          "url": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "duration": { "type": ["integer", "string", "null"] }
        }
      }
    },
    "schedule": {
      "type": "object",
      "required": ["content", "sequence", "playout"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "media": {
          "type": "object",
          "properties": {
            "preferred_extension": { "type": "string" },
            "mp4_only": { "type": "boolean" }
          }
        },
        "content": { "type": "array", "minItems": 1 },
        "sequence": { "type": "array", "minItems": 1 },
        "playout": { "type": "array", "minItems": 1 }
      }
    }
  }
}
